{
  "name": "kiln",
  "version": "0.1.1",
  "private": true,
  "description": "Prepare archival 3D assets for the public web, locally.",
  "author": {
    "name": "Kiln contributors",
    "email": "47731708+hongnhatpham@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hongnhatpham/kiln.git"
  },
  "type": "module",
  "main": "dist/desktop/electron/main.js",
  "scripts": {
    "dev": "install-electron && node tools/dev.mjs",
    "dev:ui": "vp dev --host 127.0.0.1",
    "build": "tsc -p tsconfig.desktop.json && vp build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.json",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "package": "pnpm build && install-electron && electron-builder --publish never",
    "agent": "node tools/agent.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.7",
    "gltf-validator": "2.0.0-dev.3.10",
    "lucide-react": "0.468.0",
    "meshoptimizer": "1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite-plus": "1.1.0"
  },
  "packageManager": "pnpm@12.6.0",
  "build": {
    "appId": "com.vdrs.kiln",
    "productName": "Kiln",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/draco3dgltf/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "resources/kiln.ico"
    },
    "nsis": {
      "artifactName": "Kiln-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Kiln",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "Kiln-Windows-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "resources/kiln.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Kiln-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Graphics",
      "icon": "resources/kiln.png",
      "artifactName": "Kiln-Linux-x64.${ext}",
      "desktop": {
        "entry": {
          "Name": "Kiln",
          "Comment": "Prepare archival 3D assets for the public web"
        }
      }
    }
  }
}
